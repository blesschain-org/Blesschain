[Unit]
Description=BlessChain Validator Bob
After=network-online.target
Wants=network-online.target

[Service]
User=t791001
Restart=always
RestartSec=5
LimitNOFILE=65535

ExecStart=/mnt/data/blesschain-target/release/blesschain-node \
  --chain /etc/blesschain/blesschain-local-raw.json \
  --base-path /var/lib/blesschain/bob \
  --validator \
  --force-authoring \
  --bob \
  --name BlessChain-Bob \
  --port 30334 \
  --rpc-port 9945 \
  --prometheus-port 9626 \
  --bootnodes /ip4/127.0.0.1/tcp/30333/p2p/12D3KooWPvdeCbYCd6EqBr7FnReEV5vdEC2yo5mQYDo3ZksZFz8Q \
  --unsafe-force-node-key-generation

[Install]
WantedBy=multi-user.target
